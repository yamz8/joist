pkgname=joist
pkgver=0.1.0
pkgrel=1
pkgdesc='RFI and submittal logs for construction projects, with a ball-in-court view'
arch=('x86_64' 'aarch64')
license=('MIT')
# notify-send (libnotify) announces overdue items; Lintel lists and opens
# the drawing sheets items link to.
# Qt 6.7 for QStandardPaths::GenericStateLocation and Material's roundedScale.
depends=('qt6-base>=6.7' 'qt6-declarative>=6.7' 'qt6-wayland' 'xdg-desktop-portal' 'libnotify')
optdepends=('lintel: link items to drawing sheets')
makedepends=('gcc' 'make')
install=joist.install
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/joist "$pkgdir/usr/bin/joist"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/joist.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/joist.svg"
  install -Dm644 "$startdir/joist.desktop" "$pkgdir/usr/share/applications/joist.desktop"
  install -Dm644 "$startdir/joist-notify.service" "$pkgdir/usr/lib/systemd/user/joist-notify.service"
  install -Dm644 "$startdir/joist-notify.timer" "$pkgdir/usr/lib/systemd/user/joist-notify.timer"
}
