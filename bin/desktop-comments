#!/usr/bin/env python3
# Writes the launcher's translated Comment lines into pkgbuild/joist.desktop
# from the catalogs, so the two can't drift. Run it after changing a catalog;
# bin/test checks they match.
import glob, json, os, re

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SOURCE = "RFI and submittal logs for construction projects."
# Desktop entries match the POSIX locale Omarchy sets, which for Norwegian
# is nb_NO, not the "no" its language picker uses.
LOCALE_KEYS = {"no": "nb"}

lines = []
for path in sorted(glob.glob(os.path.join(ROOT, "src/i18n/*.json"))):
    code = os.path.basename(path)[:-5]
    text = json.load(open(path, encoding="utf-8")).get(SOURCE)
    if code == "en" or not text:
        continue
    key = LOCALE_KEYS.get(code, code.replace("-", "_"))
    lines.append("Comment[%s]=%s" % (key, re.sub(r"[.。।۔]\s*$", "", text.strip())))

desktop = os.path.join(ROOT, "pkgbuild/joist.desktop")
kept = [line for line in open(desktop, encoding="utf-8").read().splitlines() if not line.startswith("Comment[")]
at = next(i for i, line in enumerate(kept) if line.startswith("Comment=")) + 1
open(desktop, "w", encoding="utf-8").write("\n".join(kept[:at] + lines + kept[at:]) + "\n")
print("Wrote %d comments" % len(lines))
